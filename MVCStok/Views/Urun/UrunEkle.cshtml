
@model MVCStok.Models.Entity.TblUrunler
@{
    ViewBag.Title = "UrunEkle";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<form method="post" class="form-group">
    <div>
        <label>
            Urun Adı
        </label>
        <input type="text" class="form-control" name="urunad" required="" />
    </div>
    <div>
        <label>
            Marka
        </label>
        <input type="text" class="form-control" name="MARKA" required="" />
    </div>
    <div>
        <label>
            urunKategori
        </label>
        @Html.DropDownListFor(m => m.TblKategori.KategoryuİD, (List<SelectListItem>)ViewBag.dgr, new { @class = "form-control" })
        
    </div>
    <div>
        <label>
            Fiyat
        </label>
        <input type="text" class="form-control" name="fiyat" />
    </div>
    <div>
        <label>
            Stok
        </label>
        <input type="text" class="form-control" name="stoık" />
    </div>
    <div>
        <button class="btn btn-info">
            Ürün Ekle
        </button>
    </div>
</form>

