@using MVCStok.Models.Entity
@model List<TblUrunler>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<table id="tbl1" class="table table-bordered">
    <thead>
        <tr>
            <th>Ürün Id</th>
            <th>Ürün Adı</th>
            <th>Ürün Markası</th>
            <th>Kategori</th>
            <th>Fiyat</th>
            <th>Stok</th>
            <th>Sil</th>
            <th>Güncelle</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var urn in Model)
        {
            <tr>
                <td>
                    @urn.ürünId
                </td>
                <td>
                    @urn.urunad
                </td>
                <td>
                    @urn.MARKA
                </td>
                <td>
                    @if (urn.TblKategori != null)
                    {
                        @urn.TblKategori.KategoriAD
                    }
                    else
                    {
                        <span class="text-danger">Kategori Yok</span>
                    }
                </td>
                <td>
                    @urn.fiyat
                </td>
                <td>
                    @urn.stoık
                </td>
                <td>
                    <a href="/URUN/SIL/@urn.ürünId" class="btn btn-danger">SİL</a>
                </td>
                <td>
                    <a href="/URUN/UrunGetir/@urn.ürünId" class="btn btn-success">GÜNCELLE</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a href="/URUN/UrunEkle/" class="btn btn-primary" style="margin-top: 15px;">Yeni ürün ekle</a>


<!-- CSS Dosyaları -->
<link href="~/Content/DataTables/css/dataTables.bootstrap4.css" rel="stylesheet" />
<link href="https://cdn.datatables.net/1.10.22/css/jquery.dataTables.min.css" rel="stylesheet" />

<!-- ÖNCE JQUERY (Olmazsa olmaz) -->
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>

<!-- SONRA DATATABLES JS -->
<script src="https://cdn.datatables.net/1.10.22/js/jquery.dataTables.min.js"></script>

<!-- SAYFA YÜKLENDİKTEN SONRA ÇALIŞTIRAN SCRIPT -->
<script>
    $(document).ready(function () {
        $('#tbl1').DataTable({
            "language": {
                "url": "//cdn.datatables.net/plug-ins/1.10.20/i18n/Turkish.json" // Türkçe dil desteği
            }
        });
    });
</script>