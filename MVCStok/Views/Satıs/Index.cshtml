@model MVCStok.Models.Entity.TblStok
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<button type="button" class="btn btn-primary"
        data-toggle="modal" data-target="#Modal1">
    Satış Yap
</button>

<div class="modal" id="Modal1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h2 class="modal-title">Satış Yapma Ekranı</h2>
                <button type="button" class="close"
                        data-dismiss="modal">
                    &times;
                </button>
            </div>

            <form method="post" action="/Satıs/YeniSatis">
                <div class="modal-body">
                    <label>Ürün adı</label>
                    @Html.TextAreaFor(m => m.URUN, new { @class = "form-control" })

                    <label>Müşteri Adı Soyadı</label>
                    @Html.TextAreaFor(m => m.Müsteri, new { @class = "form-control" })

                    <label>Adet</label>
                    @Html.TextAreaFor(m => m.adet, new { @class = "form-control" })

                    <label>fiyat</label>
                    @Html.TextAreaFor(m => m.Fiyat, new { @class = "form-control" })

                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-success">
                        Satış Yap
                    </button>

                    <button type="button" class="btn btn-danger"
                            data-dismiss="modal">
                        Kapat
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>